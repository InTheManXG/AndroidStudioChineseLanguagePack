<idea-plugin>
  <id>local.android.zh.welcome</id>
  <name>Android Studio 中文补译</name>
  <version>2.0.1</version>
  <vendor>本地补译</vendor>
  <description>基于当前安装版本的资源对照补译。修复旧式 Android 资源加载、菜单和静态界面文字。卸载后重启可回退。</description>
  <!-- 涉及当前版本的旧式资源缓存，限制在已验证的平台分支。 -->
  <idea-version since-build="262" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.android</depends>
  <applicationListeners>
    <listener class="local.android.zh.LocalizationSupplement" topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="local.android.zh.ProjectUiTranslation"/>
  </extensions>
  <projectListeners>
    <listener class="local.android.zh.ProjectUiTranslation" topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
  </projectListeners>
</idea-plugin>
